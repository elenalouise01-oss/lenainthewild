# Lena in the Wild: environment variables (copy to .env.local for local
# development; set the real values in Vercel → Settings → Environment Variables).

# The Intuition Blueprint guide emails (docs/intuition-blueprint.md).
# Both are server-only: never prefix them with NEXT_PUBLIC_.
# Leave them unset and the experience still works: visitors see their result
# on screen and the email step is skipped (nothing pretends to send).
# INTUITION_GUIDE_SCRIPT_URL is optional: the address is already in lib/intuition/delivery.ts
INTUITION_GUIDE_SCRIPT_SECRET=a-long-random-string-also-pasted-into-the-script

# Optional, already used by the site
# NEXT_PUBLIC_SITE_URL=https://www.lenainthewild.com
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
